#!/usr/bin/env bash
# bdus status
#
# One line group per instance: containers, health, Postgres, newest backup + age,
# version pin vs the image the api container is actually running.
# Exit code != 0 if any instance has a stopped container, failing health,
# failing Postgres, or a newest backup older than STALE_BACKUP_DAYS.
set -euo pipefail
. "$BDUS_OPS_DIR/lib/common.sh"

rc=0
now="$(date +%s)"

for i in $INSTANCES; do
  d="$(instance_dir "$i")"
  printf '%s── %s ─────────────────────────────────%s\n' "$_c" "$i" "$_z" >&2
  if [ ! -f "$d/.env" ]; then bad "  not initialised (run: bdus init $i)"; rc=1; continue; fi

  pin="$(instance_version "$i" || echo '?')"
  proj="$(instance_project "$i" || echo "bdus-$i")"

  # containers
  ps="$(dc "$i" ps --format '{{.Service}}\t{{.State}}\t{{.Image}}' 2>/dev/null || true)"
  if [ -z "$ps" ]; then bad "  no containers (down?)"; rc=1
  else
    while IFS=$'\t' read -r svc state img; do
      [ -n "$svc" ] || continue
      if [ "$state" = running ]; then ok "  $svc  running  ${_d}${img}${_z}"
      else bad "  $svc  $state"; rc=1; fi
      if [ "$svc" = api ] && [ "$pin" != latest ] && [ -n "$img" ] && [[ "$img" != *:$pin ]]; then
        warn "    api image is '$img' but .env pins $pin"
      fi
    done <<< "$ps"
  fi

  # health
  if instance_health "$i"; then ok "  health  $(env_get "$i" BDUS_PORT)${HEALTH_PATH}  → 200"
  else bad "  health  unreachable"; rc=1; fi

  # postgres
  if instance_has_pg "$i"; then
    if dc "$i" exec -T postgres pg_isready -U "$(env_get "$i" POSTGRES_USER || echo bdus)" >/dev/null 2>&1; then
      ok "  postgres  accepting connections"
    else bad "  postgres  not ready"; rc=1; fi
  fi

  # martin
  if instance_has_martin "$i"; then
    if dc "$i" exec -T martin wget -q -O /dev/null http://localhost:3000/health >/dev/null 2>&1; then
      ok "  martin  healthy"
    else bad "  martin  not ready"; rc=1; fi
  fi

  # newest backup (restic repo at <instance>/backups/repo/)
  if ! command -v restic >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    warn "  backup  restic/jq not installed — run: bdus setup host"
  elif ! backup_repo_ready "$i"; then
    bad "  backup  repo not initialised — run: bdus backup init $i"; rc=1
  else
    lt="$(rst "$i" snapshots --tag "instance:$i,kind:files" --latest 1 --json 2>/dev/null | jq -r '.[0].time // empty' || true)"
    if [ -z "$lt" ]; then bad "  backup  no snapshot yet"; rc=1
    else
      age=$(( (now - $(date -d "$lt" +%s)) / 86400 ))
      if [ "$age" -gt "$STALE_BACKUP_DAYS" ]; then bad "  backup  latest snapshot ${age}d old — stale"; rc=1
      else ok "  backup  latest snapshot ${age}d old"; fi
      vf="$(backup_verified "$i")"
      if [ -f "$vf" ]; then
        vage=$(( (now - $(date -d "$(cat "$vf")" +%s)) / 86400 ))
        [ "$vage" -gt "$BACKUP_VERIFY_DAYS" ] && warn "  verify  ${vage}d ago — run: bdus backup verify $i" || true
      else
        warn "  verify  never run — bdus backup verify $i"
      fi
      raw="$(rst "$i" stats --mode raw-data     --json 2>/dev/null | jq -r '.total_size // empty' || true)"
      res="$(rst "$i" stats --mode restore-size --json 2>/dev/null | jq -r '.total_size // empty' || true)"
      if [ -n "$raw" ] && [ -n "$res" ]; then
        say "  repo    $(numfmt --to=iec "$raw" 2>/dev/null || echo "${raw}B") on disk  vs  $(numfmt --to=iec "$res" 2>/dev/null || echo "${res}B") restored"
      fi
    fi
  fi
done

df -h "$BDUS_ROOT" | awk 'NR==1||NR==2{print "  "$0}' >&2
exit "$rc"
