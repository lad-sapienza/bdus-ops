#!/usr/bin/env bash
# bdus app add       <instance> --name <slug> --engine sqlite|pgsql --email <admin> [--db-name X] [--db-user R] [--password-stdin] [--gis] [--gis-write]
# bdus app gis       <instance> <app> [--write]
# bdus app to-pgsql  <instance> <app> [--yes]
# bdus app optimize-images <instance> <app> [--max-size N] [--dpi N] [--quality N] [--out jpg|webp] [--yes] [--no-backup]
# bdus app list      [instance|all]
# bdus app export    <instance> <app> [--out FILE]
# bdus app pack      <dir> [--name <slug>] [--out FILE]        # dev machine: folder → *.bdusapp.tgz (sqlite)
# bdus app import    <instance> <archive> [--force] [--new-jwt]
# bdus app delete    <instance> <app> [--yes] [--no-backup] [--keep-role]
#
# add    — wraps vendor/add-app.sh → bin/create-app.php in the api container.
#          Requires the api image >= 5.4.6 (>= 5.4.8 for the isolated pgsql role).
#          --gis / --gis-write: see `gis` below (--gis-write implies --gis).
# gis    — provisions PostGIS + a "gis" schema on a pgsql app's own database,
#          plus a read-only role for Martin ("<app>_martin") and, with --write,
#          a read-write role for QGIS ("<app>_gis", schema-scoped, never the
#          app's own tables). Idempotent and incremental: re-running only adds
#          what's missing (e.g. add --write later without touching the
#          already-created read-only role or its password). Credentials are
#          generated (openssl rand -hex 24) and stored in
#          projects/<app>/gis-config.json (chmod 600) — printed once here too.
#          This only provisions the role; wiring it into martin-config.yaml so
#          Martin actually serves tiles is still a manual edit (README.md,
#          "Vector tiles (Martin)") — not automated, since it's a
#          hand-maintained file.
# to-pgsql — converts a live sqlite app to pgsql in place (same name, same
#          URL): renames projects/<app> aside, builds a fresh pgsql app under
#          the same name for its native schema (bdus app add's own DDL —
#          never pgloader's), then uses pgloader (ephemeral dimitri/pgloader
#          container) in two passes: system tables get data-only ("create no
#          tables"), project tables get created+loaded from scratch. Tables
#          with only disposable content (bdus_log/versions/migrations, plus
#          bdus_queries — saved SQL that may not be Postgres-portable) are
#          excluded, not migrated. Exports a safety copy first, asks you to
#          type the app name; the renamed sqlite copy is kept, not deleted.
# optimize-images — re-encodes every raster row in an app's bdus_files table
#          (jpg/jpeg/png/bmp/tif/tiff/webp — GIFs, PDFs and SVGs are left alone)
#          to a consistent size/format/quality: shrink-only resize to fit
#          --max-size x --max-size (aspect preserved, same box semantics as the
#          app's own upload-time resizer), re-encode at --quality into --out
#          (jpg or webp), tag the result --dpi (metadata only, no resampling).
#          A multi-page source (e.g. a scanned tif) is flattened to one frame
#          first. Alpha is preserved for webp output; for jpg, which has no
#          alpha channel, it's composited onto white. The old physical file is
#          deleted and bdus_files.ext updated only when the extension actually
#          changed. Runs the conversion itself in one throwaway alpine+
#          imagemagick container against the instance's own
#          data/projects/<app>/files bind mount — no change to the api image,
#          which only carries GD (no TIFF support) — then restores www-data
#          ownership. Exports a safety copy first (skip with --no-backup) and
#          asks to confirm (skip with --yes): this recompresses in place and
#          is not reversible.
# export — one portable archive of a single app, into <instance>/exports/:
#          a single tar.gz with the projects/<app>/ tree at the top and, for a
#          pgsql app, a `db.dump` (pg_dump -Fc) beside it. No manifest — the
#          engine is read from the tree's own config.json on import.
#          gis-config.json travels for free (it lives inside projects/<app>/).
# pack   — dev-machine counterpart of `export` for an app you hold only as a
#          plain directory (a v4 app pulled off the old server, migrated
#          locally): no config.env, no running instance, no Docker — just
#          `tar`. Writes the same shape as `export`: one tar.gz whose single
#          top-level entry is <name>. sqlite only — a pgsql app's data lives
#          outside the folder, so `export` it from a live instance.
# import — the reverse: pushes the <app>/ tree in through the api container
#          (correct ownership), reads the engine from the restored config.json,
#          and for pgsql recreates the role + database from that config (and any
#          gis/martin roles from gis-config.json) before pg_restore of db.dump.
#          No container restart. Works into a different instance.
# delete — rm -rf projects/<app> and, for pgsql, DROP DATABASE WITH (FORCE) +
#          DROP ROLE (unless it is the shared POSTGRES_USER, or --keep-role) +
#          any gis/martin roles from gis-config.json.
#          Exports a safety copy first (skip with --no-backup); asks you to type
#          the app name (skip with --yes).
set -euo pipefail

# ── bdus app pack ──────────────────────────────────────────────────────────
# <dir> → the same *.bdusapp.tgz that `bdus app export` writes (one tar.gz, the
# tree at the top, no manifest), so `bdus app import` on a server ingests it
# with no special-casing. The one action meant to run on a plain dev machine:
# no config.env, no running instance, no Docker — just `tar`. Intercepted here,
# before lib/common.sh, which would demand all three.
if [ "${1:-}" = pack ]; then
  shift
  if [ -t 2 ]; then _r=$'\e[31m'; _g=$'\e[32m'; _c=$'\e[36m'; _y=$'\e[33m'; _z=$'\e[0m'
  else _r=''; _g=''; _c=''; _y=''; _z=''; fi
  pdie()  { printf '%sERROR%s %s\n' "$_r" "$_z" "$*" >&2; exit 1; }
  pok()   { printf '%s✓%s %s\n'    "$_g" "$_z" "$*" >&2; }
  pinfo() { printf '%s%s%s\n'      "$_c" "$*" "$_z" >&2; }
  pwarn() { printf '%s!%s %s\n'    "$_y" "$_z" "$*" >&2; }

  pack_usage() {
    cat >&2 <<'EOF'
usage: bdus app pack <dir> [--name <slug>] [--out FILE]

Turn a BraDypUS app directory into a portable <app>.bdusapp.tgz — the same
archive `bdus app export` writes — with no config.env, no running instance
and no Docker. sqlite apps only (a pgsql app's database lives outside the
folder; `bdus app export` it from a live instance instead).

  <dir>     one app's project directory: must hold config.json, and for a
            sqlite app db/bdus.sqlite
  --name    slug to import it as (default: the directory's own name);
            lower-case letters, digits and underscore only
  --out     archive path (default: ./<name>-pack-<timestamp>.bdusapp.tgz)

Then, on the server:  bdus app import <instance> <archive>
(add --new-jwt to that import when cloning the app to a different site).
EOF
  }

  src=''; name=''; out=''; engine='sqlite'
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)    name="${2:-}"; [ -n "$name" ] || pdie "--name needs a value"; shift 2 ;;
      --out)     out="${2:-}";  [ -n "$out" ]  || pdie "--out needs a value";  shift 2 ;;
      --engine)  engine="${2:-}"; shift 2 ;;
      -h|--help) pack_usage; exit 0 ;;
      -*)        pdie "unknown option: $1  (bdus app pack -h for usage)" ;;
      *)         [ -z "$src" ] || pdie "only one directory (got '$src' then '$1')"; src="$1"; shift ;;
    esac
  done

  [ -n "$src" ] || { pack_usage; exit 2; }
  [ "$engine" = sqlite ] || pdie "pack handles sqlite only — for a pgsql app use 'bdus app export' against a running instance"
  command -v tar >/dev/null 2>&1 || pdie "missing required command: tar"

  # keep the archive clean across tar flavours: skip .DS_Store and macOS
  # xattrs (bsdtar writes com.apple.provenance pax headers that GNU tar on
  # the server then warns about on extract). Probe which flags this tar takes.
  tar_x=(--exclude '.DS_Store')
  _tp="$(mktemp -d)"
  for _o in --no-mac-metadata --no-xattrs; do
    tar "$_o" -cf /dev/null -C "$_tp" . >/dev/null 2>&1 && tar_x+=("$_o")
  done
  rm -rf "$_tp"

  src="${src%/}"
  srcabs="$(cd "$src" 2>/dev/null && pwd)" || pdie "not a directory: $src"
  base="$(basename "$srcabs")"
  parent="$(dirname "$srcabs")"
  : "${name:=$base}"
  case "$name" in ''|*[!a-z0-9_]*) pdie "bad app name '$name' (allowed: lower-case a-z, 0-9, underscore)" ;; esac

  [ -f "$srcabs/config.json" ] || pdie "no config.json in $src — point pack at a single app's directory, not its parent"
  cfg_engine="$(sed -n 's/.*"db_engine"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$srcabs/config.json")"
  cfg_engine="${cfg_engine%%$'\n'*}"
  case "$cfg_engine" in
    ''|sqlite) ;;
    *) pdie "config.json says db_engine=\"$cfg_engine\" — pack handles sqlite only; use 'bdus app export' for a $cfg_engine app" ;;
  esac
  [ -f "$srcabs/db/bdus.sqlite" ] || pdie "no db/bdus.sqlite under $src — not a sqlite app tree (or its database file is missing)"

  ts="$(date +%Y%m%d-%H%M%S)"
  [ -n "$out" ] || out="$(pwd)/${name}-pack-${ts}.bdusapp.tgz"
  outdir="$(dirname "$out")"
  [ -d "$outdir" ] || mkdir -p "$outdir" || pdie "cannot create output directory: $outdir"
  # absolutise — the final `tar czf "$out"` runs after a `cd "$work"`
  outdir="$(cd "$outdir" && pwd)" || pdie "cannot resolve output directory: $(dirname "$out")"
  out="$outdir/$(basename "$out")"

  work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
  export COPYFILE_DISABLE=1   # macOS /usr/bin/tar: don't emit ._* AppleDouble entries

  pinfo "pack  $src  →  $out   (app '$name', sqlite)"

  # One tar.gz whose single top-level entry IS the app name — exactly what
  # `bdus app import` expects, and the same shape `bdus app export` writes.
  # Stream straight from the directory when it is already named <name>;
  # otherwise stage a copy under the new name first. No manifest — import
  # reads the engine from the tree's own config.json.
  if [ "$name" = "$base" ]; then
    tar czf "$out" "${tar_x[@]}" -C "$parent" "$base" || pdie "tar of $src failed"
  else
    mkdir -p "$work/stage"
    cp -a "$srcabs" "$work/stage/$name" || pdie "could not stage $src as '$name'"
    tar czf "$out" "${tar_x[@]}" -C "$work/stage" "$name" || pdie "tar of staged '$name' failed"
  fi

  tar tzf "$out" > "$work/toc" 2>/dev/null || pdie "cannot read back $out"
  case "$(head -1 "$work/toc")" in
    "$name"|"$name"/*) : ;;
    *) pdie "internal: archive top-level is '$(head -1 "$work/toc")', expected '$name/…'" ;;
  esac

  pok "done → $out  ($(du -h "$out" | cut -f1))"
  [ "$name" = "$base" ] || pwarn "packed as '$name' (renamed from directory '$base')"
  if [ -f "$srcabs/.jwt_secret" ]; then
    pinfo "tree carries .jwt_secret — pass --new-jwt to 'bdus app import' if this goes to a different site"
  fi
  pinfo "next:  scp \"$out\" <server>:   then   bdus app import <instance> \"$(basename "$out")\""
  exit 0
fi

. "$BDUS_OPS_DIR/lib/common.sh"

action="${1:?usage: bdus app add|gis|to-pgsql|list|pack|export|import|delete ...}"; shift || true

# read four config.json fields of an app inside an instance's api container:
# engine, db_name, db_username, db_password  (one per line, may be empty)
app_cfg() {   # app_cfg <instance> <app>
  dc "$1" exec -T -e A="$2" api php -r '
    $f = "projects/".getenv("A")."/config.json";
    $c = is_file($f) ? json_decode(file_get_contents($f), true) : null;
    if (!is_array($c)) exit(3);
    echo ($c["db_engine"]??"")."\n".($c["db_name"]??"")."\n".($c["db_username"]??"")."\n".($c["db_password"]??"")."\n";
  ' 2>/dev/null
}

# read four gis-config.json fields (may not exist yet): martin_user,
# martin_password, gis_user, gis_password — one per line, may be empty
gis_cfg() {   # gis_cfg <instance> <app>
  dc "$1" exec -T -e A="$2" api php -r '
    $f = "projects/".getenv("A")."/gis-config.json";
    $c = is_file($f) ? json_decode(file_get_contents($f), true) : null;
    if (!is_array($c)) $c = [];
    echo ($c["martin_user"]??"")."\n".($c["martin_password"]??"")."\n".($c["gis_user"]??"")."\n".($c["gis_password"]??"")."\n";
  ' 2>/dev/null
}

# merge non-empty fields into projects/<app>/gis-config.json (creates it if
# missing), chmod 600. Pass "" for fields you don't want to touch.
gis_cfg_set() {   # gis_cfg_set <instance> <app> <martin_user> <martin_password> <gis_user> <gis_password>
  dc "$1" exec -T -e A="$2" -e MU="${3:-}" -e MP="${4:-}" -e GU="${5:-}" -e GP="${6:-}" api php -r '
    $f = "projects/".getenv("A")."/gis-config.json";
    $c = is_file($f) ? json_decode(file_get_contents($f), true) : [];
    if (!is_array($c)) $c = [];
    foreach (["martin_user"=>"MU","martin_password"=>"MP","gis_user"=>"GU","gis_password"=>"GP"] as $k=>$e) {
      $v = getenv($e);
      if ($v !== false && $v !== "") $c[$k] = $v;
    }
    file_put_contents($f, json_encode($c, JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES)."\n");
    chmod($f, 0600);
  '
}

valid_app_name() { case "$1" in ''|*[!a-z0-9_]*) return 1 ;; *) return 0 ;; esac; }

# Idempotent: CREATE EXTENSION/SCHEMA if missing, then a read-only "<app>_martin"
# role if missing, and — when want_write=1 — a read-write "<app>_gis" role if
# missing. Safe to call repeatedly (e.g. add --write later).
gis_enable() {   # gis_enable <instance> <app> <want_write:0|1>
  local inst="$1" app="$2" want_write="$3"
  local eng dbname dbuser _p
  { read -r eng; read -r dbname; read -r dbuser; read -r _p; } < <(app_cfg "$inst" "$app") || true
  [ -n "$eng" ] || die "app '$app' not found on '$inst' (is it running?)"
  [ "$eng" = pgsql ] || die "'$app' is a sqlite app — GIS/Martin needs the pgsql engine"

  local su; su="$(env_get "$inst" POSTGRES_USER)"
  dc "$inst" exec -T postgres psql -U "$su" -d "$dbname" -v ON_ERROR_STOP=1 -q \
    -c "CREATE EXTENSION IF NOT EXISTS postgis" \
    -c "CREATE SCHEMA IF NOT EXISTS gis"
  ok "  extension postgis + schema gis ready in '$dbname'"

  local martin_user gis_user _mp _gp
  { read -r martin_user; read -r _mp; read -r gis_user; read -r _gp; } < <(gis_cfg "$inst" "$app") || true

  if [ -z "$martin_user" ]; then
    martin_user="${app}_martin"
    local pw; pw="$(gen_pw)"
    printf 'CREATE ROLE "%s" LOGIN PASSWORD %s;\n' "$martin_user" "'$pw'" \
      | dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q
    dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q \
      -c "GRANT CONNECT ON DATABASE \"$dbname\" TO \"$martin_user\""
    gis_cfg_set "$inst" "$app" "$martin_user" "$pw" "" ""
    ok "  role '$martin_user' created (read-only on schema gis)"
    info "    password: $pw   (also in projects/$app/gis-config.json)"
  else
    info "  role '$martin_user' already enabled — unchanged"
  fi

  # Re-issued every call, not just on first creation: grants on ALL TABLES/
  # SEQUENCES only cover objects that exist right now, so this is what catches
  # up "$dbuser" and "$martin_user" on anything created since the last run —
  # sequences matter too (an autoincrement "id" column is a table PLUS a
  # sequence; GRANT ... ON ALL TABLES never implies sequence access, and a
  # role can SELECT a table yet still need nothing from its sequence, but the
  # writer role below does). Default privileges (below) are what keeps
  # *future* objects covered automatically — but a default privilege only
  # applies to objects the SAME creating role makes (PostgreSQL scopes ALTER
  # DEFAULT PRIVILEGES per role), so it's set FOR ROLE "$su" here (whoever
  # runs `bdus psql` by hand) and FOR ROLE "$gis_user" below once that role
  # exists (the expected real table creator, via QGIS).
  dc "$inst" exec -T postgres psql -U "$su" -d "$dbname" -v ON_ERROR_STOP=1 -q \
    -c "GRANT USAGE ON SCHEMA gis TO \"$dbuser\", \"$martin_user\"" \
    -c "GRANT SELECT ON ALL TABLES IN SCHEMA gis TO \"$dbuser\", \"$martin_user\"" \
    -c "GRANT SELECT ON ALL SEQUENCES IN SCHEMA gis TO \"$dbuser\", \"$martin_user\"" \
    -c "ALTER DEFAULT PRIVILEGES FOR ROLE \"$su\" IN SCHEMA gis GRANT SELECT ON TABLES TO \"$dbuser\", \"$martin_user\"" \
    -c "ALTER DEFAULT PRIVILEGES FOR ROLE \"$su\" IN SCHEMA gis GRANT SELECT ON SEQUENCES TO \"$dbuser\", \"$martin_user\""

  if [ "$want_write" -eq 1 ]; then
    if [ -z "$gis_user" ]; then
      gis_user="${app}_gis"
      local pw2; pw2="$(gen_pw)"
      printf 'CREATE ROLE "%s" LOGIN PASSWORD %s;\n' "$gis_user" "'$pw2'" \
        | dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q
      dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q \
        -c "GRANT CONNECT ON DATABASE \"$dbname\" TO \"$gis_user\""
      dc "$inst" exec -T postgres psql -U "$su" -d "$dbname" -v ON_ERROR_STOP=1 -q \
        -c "GRANT USAGE, CREATE ON SCHEMA gis TO \"$gis_user\"" \
        -c "ALTER DEFAULT PRIVILEGES FOR ROLE \"$gis_user\" IN SCHEMA gis GRANT SELECT ON TABLES TO \"$dbuser\", \"$martin_user\"" \
        -c "ALTER DEFAULT PRIVILEGES FOR ROLE \"$gis_user\" IN SCHEMA gis GRANT SELECT ON SEQUENCES TO \"$dbuser\", \"$martin_user\""
      gis_cfg_set "$inst" "$app" "" "" "$gis_user" "$pw2"
      ok "  role '$gis_user' created (read-write on schema gis — for QGIS)"
      info "    password: $pw2   (also in projects/$app/gis-config.json)"
    else
      info "  role '$gis_user' already enabled — unchanged"
    fi
    # catch-up for tables/sequences gis_user doesn't already own (e.g.
    # created by "$su" or restored by `bdus app import` under "$dbuser"'s
    # ownership) — same reasoning as the martin/dbuser catch-up above
    dc "$inst" exec -T postgres psql -U "$su" -d "$dbname" -v ON_ERROR_STOP=1 -q \
      -c "GRANT ALL ON ALL TABLES IN SCHEMA gis TO \"$gis_user\"" \
      -c "GRANT ALL ON ALL SEQUENCES IN SCHEMA gis TO \"$gis_user\""
  fi

  info "  to actually serve tiles, add a postgres: entry to martin-config.yaml — see README.md"
}

case "$action" in

  add)
    inst="${1:?bdus app add <instance> --name ... --engine ... --email ...}"; shift
    instance_known "$inst" || die "unknown instance '$inst'"
    gis=0 giswrite=0 name=""
    fwd_args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --gis)       gis=1; shift ;;
        --gis-write) gis=1; giswrite=1; shift ;;
        --name)      name="${2:-}"; fwd_args+=("$1" "${2:-}"); shift 2 ;;
        *)           fwd_args+=("$1"); shift ;;
      esac
    done
    "$BDUS_OPS_DIR/vendor/add-app.sh" "$(instance_dir "$inst")" "${fwd_args[@]}"
    if [ "$gis" -eq 1 ]; then
      [ -n "$name" ] || die "internal error: --name not captured for --gis"
      gis_enable "$inst" "$name" "$giswrite"
    fi
    ;;

  gis)
    inst="${1:?bdus app gis <instance> <app> [--write]}"; app="${2:?missing <app>}"; shift 2 || true
    write=0
    while [ $# -gt 0 ]; do case "$1" in
      --write) write=1; shift ;;
      *) die "unknown option: $1" ;;
    esac; done
    instance_known "$inst" || die "unknown instance '$inst'"
    valid_app_name "$app" || die "bad app name '$app'"
    gis_enable "$inst" "$app" "$write"
    ;;

  to-pgsql)
    inst="${1:?bdus app to-pgsql <instance> <app> [--yes]}"; app="${2:?missing <app>}"; shift 2 || true
    yes=0
    while [ $# -gt 0 ]; do case "$1" in
      --yes|-y) yes=1; shift ;;
      *) die "unknown option: $1" ;;
    esac; done
    instance_known "$inst" || die "unknown instance '$inst'"
    valid_app_name "$app" || die "bad app name '$app'"
    instance_has_pg "$inst" || die "$inst has no Postgres service — enable INSTANCE_${inst}_POSTGRES=1 first"

    { read -r eng; read -r _dn; read -r _du; read -r _dp; } < <(app_cfg "$inst" "$app") || true
    [ -n "$eng" ] || die "app '$app' not found on '$inst'"
    [ "$eng" = sqlite ] || die "'$app' is already '$eng', not sqlite — nothing to convert"

    say ""
    warn "CONVERT $inst/$app  sqlite → pgsql — structural change to a live app"
    say "  projects/$app  →  projects/${app}-sqlite  (kept as rollback safety net, not deleted)"
    say "  a fresh pgsql app is created under the same name (same URL, same config.json path)"
    say "  migrated: bdus_users/cfg_app/cfg_tables/cfg_fields + every other system table with real"
    say "  data (files, geodata, rs, userlinks, vocabularies, zotero, charts, ...) + all project tables"
    say "  NOT migrated: bdus_log, bdus_versions, bdus_migrations (fresh state is correct for these),"
    say "  bdus_queries (saved SQL may use SQLite-only syntax — not portable, flagged after the fact)"
    say ""

    info "safety export first…"
    "$BDUS_OPS_DIR/libexec/bdus-app" export "$inst" "$app" || die "export failed — aborting"

    if [ "$yes" -ne 1 ]; then
      printf 'Type the app name "%s" to confirm: ' "$app" >&2
      read -r ans </dev/tty 2>/dev/null || read -r ans || true
      [ "$ans" = "$app" ] || { info "aborted"; exit 0; }
    fi

    d="$(instance_dir "$inst")"

    # 1 — set the sqlite app aside (rename, not copy — this is also what
    #     unblocks step 2, since add-app.sh refuses if projects/<app> exists)
    dc "$inst" exec -T -e A="$app" api sh -c 'mv "projects/$A" "projects/${A}-sqlite"'
    ok "  projects/$app → projects/${app}-sqlite"

    # 2 — fresh pgsql app under the same name: native schema (all 24 system
    #     tables, BraDypUS's own FK/index conventions) + correct config.json.
    #     Throwaway admin — bdus_users gets truncated and reloaded with the
    #     real list in step 5.
    throwaway_pw="$(gen_pw)"
    printf '%s' "$throwaway_pw" | "$BDUS_OPS_DIR/vendor/add-app.sh" "$d" \
      --name "$app" --engine pgsql --email "to-pgsql-placeholder@migration.invalid" --password-stdin >/dev/null
    ok "  fresh pgsql app '$app' created (native schema)"

    # 3 — real files (add-app.sh created these dirs empty)
    dc "$inst" exec -T -e A="$app" api sh -c '
      cp -a "projects/${A}-sqlite/files/." "projects/$A/files/" 2>/dev/null || true
      cp -a "projects/${A}-sqlite/geodata/." "projects/$A/geodata/" 2>/dev/null || true
    '
    ok "  files/ and geodata/ restored"

    su="$(env_get "$inst" POSTGRES_USER)"
    { read -r _e; read -r dbname; read -r dbuser; read -r dbpass; } < <(app_cfg "$inst" "$app")

    # 4 — trimmed sqlite copy: drop the tables we deliberately don't migrate.
    #     Lives inside data/projects (the bind mount) so both the host (for
    #     the pgloader mount below) and the api container (to run the DROP
    #     TABLEs) see the same file, at their own respective paths.
    trimmed_container="projects/.to-pgsql-${app}.sqlite"
    trimmed_host="$d/data/projects/.to-pgsql-${app}.sqlite"
    cp "$d/data/projects/${app}-sqlite/db/bdus.sqlite" "$trimmed_host"
    trap 'rm -f "$trimmed_host"; rm -rf "${work:-}"' EXIT
    dc "$inst" exec -T -e T="$trimmed_container" api php -r '
      $db = new PDO("sqlite:".getenv("T"));
      foreach (["bdus_log","bdus_versions","bdus_queries","bdus_migrations"] as $t) {
        $db->exec("DROP TABLE IF EXISTS \"$t\"");
      }
    '
    ok "  trimmed sqlite copy ready (log/versions/queries/migrations excluded)"

    # 5 — the 4 system tables `bdus app add` just seeded with real rows: empty
    #     them before pgloader loads the real ones. CASCADE because
    #     bdus_queries still physically exists (empty) with a FK to bdus_users.
    dc "$inst" exec -T postgres psql -U "$dbuser" -d "$dbname" -v ON_ERROR_STOP=1 -q \
      -c "TRUNCATE bdus_users, bdus_cfg_app, bdus_cfg_tables, bdus_cfg_fields CASCADE"
    ok "  fresh-app seed rows cleared"

    # 6 — pgloader, two passes, ephemeral container on the instance's own
    #     compose network (plain `docker run`, not `docker compose run` —
    #     pgloader isn't a declared service, same pattern already used
    #     elsewhere in bdus-ops for one-off containers).
    work="$(work_dir)"
    target="postgresql://${dbuser}:${dbpass}@postgres:5432/${dbname}"
    cat > "$work/pass-a.load" <<EOF
load database
     from sqlite:///data/app.sqlite
     into ${target}
 with include no drop, create no tables, truncate, reset sequences
 including only table names like 'bdus%'
;
EOF
    cat > "$work/pass-b.load" <<EOF
load database
     from sqlite:///data/app.sqlite
     into ${target}
 with include drop, create tables, create indexes, reset sequences
 excluding table names like 'bdus%'
;
EOF
    chmod 600 "$work"/*.load
    net="$(instance_project "$inst")_bradypus-net"
    info "pgloader pass 1/2 (system table data)…"
    docker run --rm --network "$net" \
      -v "$work:/scripts:ro" \
      -v "$trimmed_host:/data/app.sqlite:ro" \
      dimitri/pgloader pgloader /scripts/pass-a.load
    info "pgloader pass 2/2 (project tables)…"
    docker run --rm --network "$net" \
      -v "$work:/scripts:ro" \
      -v "$trimmed_host:/data/app.sqlite:ro" \
      dimitri/pgloader pgloader /scripts/pass-b.load
    ok "  data migrated"

    ok "converted '$app' on '$inst' to pgsql"
    warn "  bdus_queries (saved SQL) was NOT migrated — SQLite syntax may not be valid on Postgres; ask affected users to rewrite them"
    info "  rollback safety net kept: projects/${app}-sqlite/ (remove by hand once verified)"
    ;;

  optimize-images)
    inst="${1:?bdus app optimize-images <instance> <app> [--max-size N] [--dpi N] [--quality N] [--out jpg|webp] [--yes] [--no-backup]}"
    app="${2:?missing <app>}"; shift 2 || true
    max_size=2000 dpi=72 quality=85 out=webp yes=0 nobackup=0
    while [ $# -gt 0 ]; do case "$1" in
      --max-size)  max_size="${2:?--max-size needs a value}"; shift 2 ;;
      --dpi)       dpi="${2:?--dpi needs a value}"; shift 2 ;;
      --quality)   quality="${2:?--quality needs a value}"; shift 2 ;;
      --out)       out="${2:?--out needs a value}"; shift 2 ;;
      --yes|-y)    yes=1; shift ;;
      --no-backup) nobackup=1; shift ;;
      *) die "unknown option: $1" ;;
    esac; done
    instance_known "$inst" || die "unknown instance '$inst'"
    valid_app_name "$app" || die "bad app name '$app'"
    [[ "$max_size" =~ ^[0-9]+$ ]] && [ "$max_size" -gt 0 ]                      || die "--max-size must be a positive integer"
    [[ "$dpi"      =~ ^[0-9]+$ ]] && [ "$dpi" -gt 0 ]                           || die "--dpi must be a positive integer"
    [[ "$quality"  =~ ^[0-9]+$ ]] && [ "$quality" -ge 1 ] && [ "$quality" -le 100 ] || die "--quality must be an integer 1-100"
    case "$out" in jpg|webp) ;; *) die "--out must be 'jpg' or 'webp' (got '$out')" ;; esac

    { read -r eng; read -r dbname; read -r dbuser; read -r _dbpass; } < <(app_cfg "$inst" "$app") || true
    [ -n "$eng" ] || die "app '$app' not found on '$inst' (is it running?)"

    d="$(instance_dir "$inst")"
    files_dir="$d/data/projects/$app/files"
    [ -d "$files_dir" ] || die "no files/ directory for '$app' on '$inst' ($files_dir)"

    work="$(work_dir)"; trap 'rm -rf "$work"' EXIT

    # 1 — candidate rows: raster images only; gif/svg/pdf/anything else is never selected
    info "listing candidate images in '$app' ($eng)…"
    if [ "$eng" = pgsql ]; then
      dc "$inst" exec -T postgres psql -U "$dbuser" -d "$dbname" -tAqc \
        "SELECT id::text || chr(9) || lower(ext) FROM bdus_files WHERE lower(ext) IN ('jpg','jpeg','png','bmp','tif','tiff','webp')" \
        | grep -v '^$' > "$work/candidates.tsv" || true
    else
      dc "$inst" exec -T -e A="$app" api php -r '
        $db = new PDO("sqlite:projects/".getenv("A")."/db/bdus.sqlite");
        $exts = ["jpg","jpeg","png","bmp","tif","tiff","webp"];
        $ph = implode(",", array_fill(0, count($exts), "?"));
        $stmt = $db->prepare("SELECT id, ext FROM bdus_files WHERE lower(ext) IN ($ph)");
        $stmt->execute($exts);
        foreach ($stmt as $row) { echo $row["id"]."\t".strtolower($row["ext"])."\n"; }
      ' > "$work/candidates.tsv"
    fi

    total="$(wc -l < "$work/candidates.tsv" | tr -d ' ')"
    [ "$total" -gt 0 ] || { ok "no matching images in '$app' — nothing to do"; exit 0; }

    say ""
    warn "OPTIMIZE IMAGES  $inst/$app  ($eng) — recompresses in place, not reversible"
    say "  $total candidate image(s) (jpg/jpeg/png/bmp/tif/tiff/webp rows in bdus_files)"
    say "  resized to fit ${max_size}x${max_size} (shrink-only), re-encoded as .$out at quality $quality, tagged ${dpi}dpi"
    say "  multi-page sources (tif) flattened to one frame; alpha kept for webp, white for jpg"
    say "  GIFs, PDFs and SVGs are left untouched"
    say ""

    if [ "$nobackup" -ne 1 ]; then
      info "exporting first (safety copy)…"
      "$BDUS_OPS_DIR/libexec/bdus-app" export "$inst" "$app" || die "export failed — aborting"
    else
      warn "--no-backup: the originals will not be recoverable"
    fi

    [ "$yes" -eq 1 ] || confirm "Proceed?" || { info "aborted"; exit 0; }

    # 2 — the actual conversion, in one throwaway alpine+imagemagick container
    #     against the instance's own bind mount: the api image only carries GD
    #     (no TIFF support), and spinning one container per file would be far
    #     too slow for a whole app's image library.
    cat > "$work/optimize.sh" <<'SCRIPT'
#!/bin/sh
set -u
rm -f /files/.optimize-*-tmp.* 2>/dev/null || true
tab="$(printf '\t')"

process() {
  id="$1"; oldext="$2"
  src="/files/$id.$oldext"
  if [ ! -f "$src" ]; then
    echo "FAIL $id $oldext missing-source-file"
    return
  fi
  # the temp file's real extension must exactly match $OUT_EXT — a trailing
  # .tmp (e.g. ".jpg.tmp") makes imagemagick fall back to a generic writer
  # for resolution metadata, silently ignoring -density/-units below (the
  # pixels still came out as the right format, only the dpi tag was wrong),
  # so "tmp" goes in the basename, not after the extension.
  tmp="/files/.optimize-${id}-tmp.${OUT_EXT}"
  err="/tmp/err-$id"
  if [ "$OUT_EXT" = jpg ]; then
    magick "$src" -auto-orient -background none -flatten \
      -resize "${MAXSZ}x${MAXSZ}>" -units PixelsPerInch -density "$DPI" \
      -background white -alpha remove -alpha off -quality "$QUALITY" \
      "$tmp" 2>"$err"
  else
    magick "$src" -auto-orient -background none -flatten \
      -resize "${MAXSZ}x${MAXSZ}>" -units PixelsPerInch -density "$DPI" \
      -quality "$QUALITY" \
      "$tmp" 2>"$err"
  fi
  rc=$?
  if [ "$rc" -ne 0 ] || [ ! -s "$tmp" ]; then
    echo "FAIL $id $oldext $(tr '\n' ' ' < "$err" | cut -c1-200)"
    rm -f "$tmp" "$err"
    return
  fi
  rm -f "$err"
  dst="/files/$id.$OUT_EXT"
  mv -f "$tmp" "$dst"
  [ "$oldext" = "$OUT_EXT" ] || rm -f "$src"
  echo "OK $id $oldext $OUT_EXT"
}

while IFS="$tab" read -r id oldext; do
  [ -n "$id" ] || continue
  process "$id" "$oldext"
done < /work/candidates.tsv
SCRIPT

    info "converting… (throwaway alpine+imagemagick container)"
    ( t0=$SECONDS; while sleep 30; do info "  still converting… $((SECONDS - t0))s"; done ) &
    hb=$!
    if docker run --rm \
         -e MAXSZ="$max_size" -e DPI="$dpi" -e QUALITY="$quality" -e OUT_EXT="$out" \
         -v "$work:/work:ro" -v "$files_dir:/files" \
         alpine sh -c 'apk add --no-cache imagemagick imagemagick-jpeg imagemagick-tiff imagemagick-webp >/dev/null 2>&1 && sh /work/optimize.sh' \
         > "$work/results.tsv"; then
      kill "$hb" 2>/dev/null || true; wait "$hb" 2>/dev/null || true
    else
      kill "$hb" 2>/dev/null || true; wait "$hb" 2>/dev/null || true
      die "image-conversion container failed (docker/network/apk issue?) — bdus_files was not touched"
    fi

    # ownership — the alpine container wrote these files as root
    dc "$inst" exec -T api chown -R www-data:www-data "projects/$app/files" 2>/dev/null || true

    ok_n="$(grep -c '^OK'   "$work/results.tsv" || true)"
    fail_n="$(grep -c '^FAIL' "$work/results.tsv" || true)"
    ok "  converted $ok_n/$total image(s)"
    if [ "$fail_n" -gt 0 ]; then
      warn "  $fail_n failed (left untouched):"
      grep '^FAIL' "$work/results.tsv" | sed 's/^/    /' >&2
    fi

    # 3 — bdus_files.ext, only for rows whose extension actually changed
    awk '$1=="OK" && $3!=$4 { print $2"\t"$4 }' "$work/results.tsv" > "$work/updates.tsv"
    upd_n="$(wc -l < "$work/updates.tsv" | tr -d ' ')"
    if [ "$upd_n" -gt 0 ]; then
      info "updating bdus_files.ext for $upd_n row(s)…"
      if [ "$eng" = pgsql ]; then
        { echo "BEGIN;"
          while IFS="$(printf '\t')" read -r id newext; do
            [ -n "$id" ] || continue
            printf "UPDATE bdus_files SET ext = '%s' WHERE id = %s;\n" "$newext" "$id"
          done < "$work/updates.tsv"
          echo "COMMIT;"
        } | dc "$inst" exec -T postgres psql -U "$dbuser" -d "$dbname" -v ON_ERROR_STOP=1 -q
      else
        dc "$inst" exec -T -e A="$app" api php -r '
          $db = new PDO("sqlite:projects/".getenv("A")."/db/bdus.sqlite");
          $db->beginTransaction();
          $stmt = $db->prepare("UPDATE bdus_files SET ext = ? WHERE id = ?");
          while (($line = fgets(STDIN)) !== false) {
            $line = trim($line);
            if ($line === "") continue;
            [$id, $ext] = explode("\t", $line, 2);
            $stmt->execute([$ext, (int)$id]);
          }
          $db->commit();
        ' < "$work/updates.tsv"
      fi
      ok "  bdus_files updated ($upd_n row(s))"
    fi

    ok "optimized images for '$app' on '$inst'"
    ;;

  list)
    while read -r i; do
      [ -f "$(instance_dir "$i")/.env" ] || continue
      printf '%s%s%s\n' "$_c" "$i" "$_z" >&2
      dc "$i" exec -T api sh -lc '
        for d in projects/*/; do
          [ -f "$d/config.json" ] || continue
          n=$(basename "$d")
          e=$(sed -n "s/.*\"db_engine\"[[:space:]]*:[[:space:]]*\"\([a-z]*\)\".*/\1/p" "$d/config.json" | head -1)
          db=$(sed -n "s/.*\"db_name\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$d/config.json" | head -1)
          printf "  %-24s %-8s %s\n" "$n" "${e:-?}" "$db"
        done
      ' 2>/dev/null || warn "  ($i not running)"
    done < <(resolve_instances "${1:-all}")
    ;;

  export)
    inst="${1:?bdus app export <instance> <app> [--out FILE]}"; app="${2:?missing <app>}"; shift 2 || true
    out=""
    while [ $# -gt 0 ]; do case "$1" in
      --out) out="${2:?}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac; done
    instance_known "$inst" || die "unknown instance '$inst'"
    valid_app_name "$app" || die "bad app name '$app'"

    { read -r eng; read -r dbname; read -r dbuser; read -r _dbpass; } < <(app_cfg "$inst" "$app") || true
    [ -n "$eng" ] || die "app '$app' not found on '$inst' (is it running?)"

    ts="$(date +%Y%m%d-%H%M%S)"
    expdir="$(instance_dir "$inst")/exports"; mkdir -p "$expdir"
    [ -n "$out" ] || out="$expdir/${app}-${inst}-${ts}.bdusapp.tgz"

    work="$(work_dir)"; trap 'rm -rf "$work"' EXIT
    info "export $inst/$app ($eng) → $out"

    # the projects/<app>/ tree — a plain tar from inside the api container (root
    # there, so 0600 files like .jwt_secret are readable), unpacked into $work/
    dc "$inst" exec -T -e A="$app" api sh -c 'cd /var/www/html/projects && exec tar cf - "$A"' \
      | tar xf - --no-same-owner -C "$work"
    [ -d "$work/$app" ] || die "  tree export produced no '$app/' (is '$inst' up?)"
    ok "  $app/ tree  ($(du -sh "$work/$app" | cut -f1))"

    if [ "$eng" = pgsql ]; then
      dc "$inst" exec -T postgres pg_dump -Fc -U "$(env_get "$inst" POSTGRES_USER)" -d "$dbname" > "$work/db.dump"
      ok "  db.dump  ($(du -h "$work/db.dump" | cut -f1))  [database $dbname]"
    fi

    # one tar.gz: <app>/ at the top, db.dump beside it (pgsql only). No manifest —
    # import reads the engine from the tree's own config.json.
    ( cd "$work" && tar czf "$out" "$app" $( [ "$eng" = pgsql ] && echo db.dump ) )
    ok "done → $out  ($(du -h "$out" | cut -f1))"
    ;;

  import)
    inst="${1:?bdus app import <instance> <archive> [--force] [--new-jwt]}"; file="${2:?missing <archive>}"; shift 2 || true
    force=0; newjwt=0
    while [ $# -gt 0 ]; do case "$1" in
      --force)   force=1; shift ;;
      --new-jwt) newjwt=1; shift ;;
      *) die "unknown option: $1" ;;
    esac; done
    instance_known "$inst" || die "unknown instance '$inst'"
    [ -f "$file" ] || die "archive not found: $file"

    work="$(work_dir)"; trap 'rm -rf "$work"' EXIT
    tar xzf "$file" -C "$work"

    # a bdusapp bundle is one tar.gz: exactly one top-level <app>/ directory,
    # plus a sibling db.dump for an external-DB app. No manifest — the engine
    # comes from the tree's own config.json once it is in place.
    app=""
    for d in "$work"/*/; do
      [ -d "$d" ] || continue
      [ -z "$app" ] || die "archive has more than one top-level directory — not a bdusapp bundle"
      app="$(basename "$d")"
    done
    [ -n "$app" ] || die "no <app>/ directory at the archive root — old-format bundle? re-export it"
    valid_app_name "$app" || die "archive top-level '$app' is not a valid app name"
    has_dump=0; [ -f "$work/db.dump" ] && has_dump=1

    info "import '$app' → $inst"

    if dc "$inst" exec -T api test -d "projects/$app" 2>/dev/null; then
      [ "$force" -eq 1 ] || die "app '$app' already exists on '$inst' — pass --force to replace it"
      warn "replacing existing '$app' on '$inst'"
      # read the OLD app's config before removing the tree that holds it, to know
      # which DB objects to drop — the incoming app may be a different engine.
      { read -r oeng; read -r odb; read -r ousr; read -r _op; } < <(app_cfg "$inst" "$app") || true
      { read -r omu; read -r _omp; read -r ogu; read -r _ogp; } < <(gis_cfg "$inst" "$app") || true
      dc "$inst" exec -T -e A="$app" api sh -c 'rm -rf "projects/$A"'
      if [ "${oeng:-}" = pgsql ]; then
        su="$(env_get "$inst" POSTGRES_USER)"
        [ -z "${odb:-}" ] || dc "$inst" exec -T postgres psql -U "$su" -d postgres -q \
          -c "DROP DATABASE IF EXISTS \"$odb\" WITH (FORCE)" -c "DROP ROLE IF EXISTS \"$ousr\"" || true
        for r in "${omu:-}" "${ogu:-}"; do
          [ -n "$r" ] && dc "$inst" exec -T postgres psql -U "$su" -d postgres -q -c "DROP ROLE IF EXISTS \"$r\"" || true
        done
      fi
    fi

    # 1 — the projects/<app>/ tree, pushed in through the api container (root
    #     there → correct ownership), inlining what docker-restore.sh did
    ( cd "$work" && tar cf - "$app" ) \
      | dc "$inst" exec -T -e A="$app" api sh -c 'cd /var/www/html/projects && tar xf - && chown -R www-data:www-data "$A"'
    ok "  projects/$app restored"

    # 2 — engine from the just-restored config.json (single source of truth)
    { read -r eng; read -r dbname; read -r dbuser; read -r dbpass; } < <(app_cfg "$inst" "$app")
    [ -n "$eng" ] || die "restored config.json for '$app' has no db_engine"
    if [ "$eng" = pgsql ] && [ "$has_dump" -eq 0 ]; then die "config.json says pgsql but the archive carries no db.dump"; fi
    if [ "$eng" != pgsql ] && [ "$has_dump" -eq 1 ]; then die "archive carries a db.dump but config.json engine is '$eng'"; fi

    if [ "$eng" = pgsql ]; then
      su="$(env_get "$inst" POSTGRES_USER)"
      [ -n "$dbname" ] && [ -n "$dbuser" ] && [ -n "$dbpass" ] || die "config.json of '$app' lacks db_name/username/password"

      if [ "$(dc "$inst" exec -T postgres psql -U "$su" -d postgres -tAqc "SELECT 1 FROM pg_roles WHERE rolname='$dbuser'" | tr -d '[:space:]')" != 1 ]; then
        printf 'CREATE ROLE "%s" LOGIN PASSWORD %s;\n' "$dbuser" "'$dbpass'" \
          | dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q
        ok "  role '$dbuser' created"
      fi
      if [ "$(dc "$inst" exec -T postgres psql -U "$su" -d postgres -tAqc "SELECT 1 FROM pg_database WHERE datname='$dbname'" | tr -d '[:space:]')" != 1 ]; then
        dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q \
          -c "CREATE DATABASE \"$dbname\" OWNER \"$dbuser\"" \
          -c "REVOKE CONNECT ON DATABASE \"$dbname\" FROM PUBLIC" \
          -c "GRANT  CONNECT ON DATABASE \"$dbname\" TO \"$dbuser\""
        ok "  database '$dbname' created (owner $dbuser)"
      fi

      # gis/martin roles (if this app had them) — recreate with the SAME stored
      # password before restoring, so the dump's own GRANT statements (pg_dump
      # captures ACLs) resolve against roles that already exist instead of
      # erroring/skipping.
      { read -r mu; read -r mp; read -r gu; read -r gp; } < <(gis_cfg "$inst" "$app") || true
      for pair in "$mu:$mp" "$gu:$gp"; do
        ru="${pair%%:*}"; rp="${pair#*:}"
        [ -n "$ru" ] || continue
        if [ "$(dc "$inst" exec -T postgres psql -U "$su" -d postgres -tAqc "SELECT 1 FROM pg_roles WHERE rolname='$ru'" | tr -d '[:space:]')" != 1 ]; then
          printf 'CREATE ROLE "%s" LOGIN PASSWORD %s;\n' "$ru" "'$rp'" \
            | dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q
          dc "$inst" exec -T postgres psql -U "$su" -d postgres -v ON_ERROR_STOP=1 -q \
            -c "GRANT CONNECT ON DATABASE \"$dbname\" TO \"$ru\""
          ok "  role '$ru' recreated (gis)"
        fi
      done

      # pg_restore runs with --role="$dbuser" so tables end up owned by the
      # app's own role, not the shared superuser — but that means the dump's
      # own "CREATE EXTENSION postgis" and "ALTER DEFAULT PRIVILEGES FOR ROLE
      # <other>" statements fail (both need superuser, and --role effectively
      # downgrades the whole restore session to $dbuser). Extensions dodge
      # this: pre-create postgis here AS the superuser so the dump's own
      # "IF NOT EXISTS" version of the same statement is a privilege-free
      # no-op — this alone unblocks every geometry-typed object (tables,
      # data, constraints) that would otherwise cascade-fail. The default
      # privilege statements still fail (harmless "errors ignored on
      # restore" warnings from pg_restore) — gis_enable, called again right
      # after, reapplies them as the superuser, which does have permission.
      if [ -n "$mu" ]; then
        dc "$inst" exec -T postgres psql -U "$su" -d "$dbname" -v ON_ERROR_STOP=1 -q \
          -c "CREATE EXTENSION IF NOT EXISTS postgis"
        # A PostGIS-enabled dump always throws a few more ignorable warnings on
        # restore beyond the two ALTER DEFAULT PRIVILEGES above — the
        # extension's own COMMENT and its spatial_ref_sys reference table are
        # owned by whoever ran CREATE EXTENSION (the superuser here), so
        # --role="$dbuser" can't touch them; spatial_ref_sys already has its
        # standard contents from CREATE EXTENSION itself, so the skipped COPY
        # loses nothing. This is a well-known, harmless pg_dump/PostGIS
        # interaction — pg_restore exits non-zero purely because it counted
        # ignored errors, not because the restore is actually broken, so
        # don't let it abort the script here (a non-postgis app below still
        # aborts on any pg_restore error, unchanged).
        dc "$inst" exec -T postgres pg_restore -U "$su" -d "$dbname" --no-owner --role="$dbuser" < "$work/db.dump" \
          || warn "  pg_restore reported ignorable postgis/permission warnings above (expected)"
      else
        dc "$inst" exec -T postgres pg_restore -U "$su" -d "$dbname" --no-owner --role="$dbuser" < "$work/db.dump"
      fi
      ok "  database '$dbname' loaded"

      if [ -n "$mu" ]; then
        info "  reconciling gis grants/default-privileges"
        gis_enable "$inst" "$app" "$( [ -n "$gu" ] && echo 1 || echo 0 )" >/dev/null
        ok "  gis grants reconciled"
      fi
    fi

    if [ "$newjwt" -eq 1 ]; then
      dc "$inst" exec -T -e A="$app" api sh -c 'rm -f "projects/$A/.jwt_secret"'
      ok "  .jwt_secret cleared (regenerated on next login)"
    fi

    ok "imported '$app' into '$inst' ($eng) — live, no restart"
    ;;

  delete|rm)
    inst="${1:?bdus app delete <instance> <app> [--yes] [--no-backup] [--keep-role]}"; app="${2:?missing <app>}"; shift 2 || true
    yes=0; nobackup=0; keeprole=0
    while [ $# -gt 0 ]; do case "$1" in
      --yes|-y)    yes=1; shift ;;
      --no-backup) nobackup=1; shift ;;
      --keep-role) keeprole=1; shift ;;
      *) die "unknown option: $1" ;;
    esac; done
    instance_known "$inst" || die "unknown instance '$inst'"
    valid_app_name "$app" || die "bad app name '$app'"

    { read -r eng; read -r dbname; read -r dbuser; read -r _p; } < <(app_cfg "$inst" "$app") || true
    [ -n "$eng" ] || die "app '$app' not found on '$inst'"
    su="$(env_get "$inst" POSTGRES_USER || true)"

    martin_user="" gis_user=""
    if [ "$eng" = pgsql ]; then
      { read -r martin_user; read -r _mp; read -r gis_user; read -r _gp; } < <(gis_cfg "$inst" "$app") || true
    fi

    say ""
    warn "DELETE $inst/$app ($eng) — irreversible"
    say "  rm -rf projects/$app"
    if [ "$eng" = pgsql ]; then
      say "  DROP DATABASE \"$dbname\" WITH (FORCE)"
      if [ "$keeprole" -ne 1 ] && [ -n "$dbuser" ] && [ "$dbuser" != "$su" ]; then
        say "  DROP ROLE \"$dbuser\""
      else
        say "  (role \"$dbuser\" kept)"
      fi
      [ -n "$martin_user" ] && say "  DROP ROLE \"$martin_user\""
      [ -n "$gis_user" ]    && say "  DROP ROLE \"$gis_user\""
    fi
    say ""

    if [ "$nobackup" -ne 1 ]; then
      info "exporting first (safety copy)…"
      "$BDUS_OPS_DIR/libexec/bdus-app" export "$inst" "$app" || die "export failed — aborting delete"
    else
      warn "--no-backup: nothing will be recoverable"
    fi

    if [ "$yes" -ne 1 ]; then
      printf 'Type the app name "%s" to confirm: ' "$app" >&2
      read -r ans </dev/tty 2>/dev/null || read -r ans || true
      [ "$ans" = "$app" ] || { info "aborted"; exit 0; }
    fi

    dc "$inst" exec -T -e A="$app" api sh -c '[ -n "$A" ] && rm -rf "projects/$A"'
    ok "  projects/$app removed"

    if [ "$eng" = pgsql ] && [ -n "$dbname" ]; then
      dc "$inst" exec -T postgres psql -U "$su" -d postgres -q -c "DROP DATABASE IF EXISTS \"$dbname\" WITH (FORCE)"
      ok "  database '$dbname' dropped"
      if [ "$keeprole" -ne 1 ] && [ -n "$dbuser" ] && [ "$dbuser" != "$su" ]; then
        if dc "$inst" exec -T postgres psql -U "$su" -d postgres -q -c "DROP ROLE IF EXISTS \"$dbuser\""; then
          ok "  role '$dbuser' dropped"
        else
          warn "  could not drop role '$dbuser' (still owns objects elsewhere?) — drop it by hand"
        fi
      fi
      for r in "$martin_user" "$gis_user"; do
        [ -n "$r" ] || continue
        if dc "$inst" exec -T postgres psql -U "$su" -d postgres -q -c "DROP ROLE IF EXISTS \"$r\""; then
          ok "  role '$r' dropped"
        else
          warn "  could not drop role '$r' — drop it by hand"
        fi
      done
      if [ -n "$martin_user" ] || [ -n "$gis_user" ]; then
        warn "  remove '$app's entry (if any) from martin-config.yaml by hand — not automated"
      fi
    fi

    ok "deleted '$app' from '$inst'"
    ;;

  -h|--help) sed -n '2,/^set -euo pipefail$/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *) die "unknown action '$action' (add|gis|to-pgsql|optimize-images|list|pack|export|import|delete)" ;;
esac
