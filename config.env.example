# bdus-ops config — the single source of truth for this deployment.
#
#   cp config.env.example config.env   &&   $EDITOR config.env
#
# config.env is git-ignored: it is per-server. No secrets live here — the
# Postgres password is generated by `bdus init` into <instance>/.env (chmod 600).

# ── layout ──────────────────────────────────────────────────────────────────
BDUS_ROOT=/srv/bradypus          # holds one directory per instance
INSTANCES="prod demo"            # order matters: `bdus update all` goes left → right

# ── images ──────────────────────────────────────────────────────────────────
API_IMAGE=ghcr.io/lad-sapienza/bdus-api
APP_IMAGE=ghcr.io/lad-sapienza/bdus-app
GHCR_YAML_REF=v5                 # git ref for the raw bradypus.yml fetched by `bdus init`
BDUS_VERSION=latest              # default pin written by `bdus init` (override: bdus init <i> --version X.Y.Z)

# ── health / status ─────────────────────────────────────────────────────────
HEALTH_PATH=/api/new-app/status  # unauthenticated 200 endpoint
STALE_BACKUP_DAYS=2              # `bdus status` fails if the newest backup is older

# ── backups ─────────────────────────────────────────────────────────────────
BACKUP_RETENTION=14              # archives kept per instance per kind
BACKUP_RSYNC_TARGET=             # e.g. backup@storage:/backups/  — empty = no off-box copy

# ── host firewall (bdus setup host) ─────────────────────────────────────────
# space-separated IPs allowed to reach the instances' published ports
# (everything else is dropped in the DOCKER-USER chain). Typically the proxy VM.
PROXY_ALLOW_IPS="192.168.3.186"

# ── per-instance settings (used by `bdus init`) ─────────────────────────────
# INSTANCE_<name>_PORT           bind for the frontend, <ip>:<port> (ip = private iface, never 0.0.0.0)
# INSTANCE_<name>_POSTGRES       1 = add a shared Postgres service to this instance, 0 = sqlite only
# INSTANCE_<name>_ALLOW_NEW_APP  0 (prod: flip only to create an app) or 1 (demo/edu: students create)
# INSTANCE_<name>_MEM_API        api container memory limit
# INSTANCE_<name>_MEM_FRONT      frontend container memory limit

INSTANCE_prod_PORT=192.168.4.39:8081
INSTANCE_prod_POSTGRES=1
INSTANCE_prod_ALLOW_NEW_APP=0
INSTANCE_prod_MEM_API=1g
INSTANCE_prod_MEM_FRONT=192m

INSTANCE_demo_PORT=192.168.4.39:8082
INSTANCE_demo_POSTGRES=0
INSTANCE_demo_ALLOW_NEW_APP=1
INSTANCE_demo_MEM_API=768m
INSTANCE_demo_MEM_FRONT=192m
