# bdus-ops config — the single source of truth for this deployment.
#
#   cp config.env.example config.env   &&   $EDITOR config.env
#
# config.env is git-ignored: it is per-server. No secrets live here — the
# Postgres password is generated by `bdus init` into <instance>/.env (chmod 600).

# ── layout ──────────────────────────────────────────────────────────────────
BDUS_ROOT=/srv/bradypus          # holds one directory per instance
INSTANCES="prod demo"            # order matters: `bdus update all` goes left → right

# ── images ──────────────────────────────────────────────────────────────────
API_IMAGE=ghcr.io/lad-sapienza/bdus-api
APP_IMAGE=ghcr.io/lad-sapienza/bdus-app
GHCR_YAML_REF=v5                 # git ref for the raw bradypus.yml fetched by `bdus init`
BDUS_VERSION=latest              # default pin written by `bdus init` (override: bdus init <i> --version X.Y.Z)

# ── health / status ─────────────────────────────────────────────────────────
HEALTH_PATH=/api/new-app/status  # unauthenticated 200 endpoint
STALE_BACKUP_DAYS=2              # `bdus status` fails if the newest backup is older

# ── backups (restic) ───────────────────────────────────────────────────────
# One deduplicating repo per instance at <instance>/backups/repo/, key in
# repo.key (chmod 600, also mirrored into <instance>/.env as RESTIC_PASSWORD).
# `bdus init` creates it; `bdus backup` writes one snapshot per kind
# (files, pgall, env, gis) tagged instance:<n>,run:<ts>. `bdus backup list <n>`
# shows the restore points; `bdus restore <n> --at …` restores one. A cold,
# off-box copy just needs the whole <instance>/backups/ directory.
BACKUP_KEEP="--keep-last 3 --keep-daily 7 --keep-weekly 8 --keep-monthly 12"
BACKUP_PRUNE=weekly              # when `forget` also runs --prune: weekly (Sundays) | always | never
BACKUP_VERIFY_DAYS=7             # `bdus status` warns if the last `bdus backup verify` is older

# ── host firewall (bdus setup host) ─────────────────────────────────────────
# space-separated IPs allowed to reach the instances' published ports
# (everything else is dropped in the DOCKER-USER chain). Typically the proxy VM.
PROXY_ALLOW_IPS="192.168.3.186"

# ── per-instance settings (used by `bdus init`) ─────────────────────────────
# INSTANCE_<name>_PORT           bind for the frontend, <ip>:<port> (ip = private iface, never 0.0.0.0)
# INSTANCE_<name>_POSTGRES       1 = add a shared Postgres (PostGIS-enabled) service to this instance, 0 = sqlite only
# INSTANCE_<name>_ALLOW_NEW_APP  0 (prod: flip only to create an app) or 1 (demo/edu: students create)
# INSTANCE_<name>_CORS_ORIGIN    optional: value for the API's BRADYPUS_CORS_ORIGIN — one or
#                                more allowed origins, SPACE-separated (the API does an exact
#                                match, no wildcard). QUOTE it when it has a space (this file
#                                is sourced by bash): INSTANCE_x_CORS_ORIGIN="https://a https://b"
#                                Empty (default) = leave it unset (no CORS headers; use this
#                                when frontend and API share an origin). Baked into
#                                bdus.override.yml, so a plain `bdus init <instance>` re-run
#                                picks up a change (no --force).
# INSTANCE_<name>_MEM_API        api container memory limit
# INSTANCE_<name>_MEM_FRONT      frontend container memory limit
# INSTANCE_<name>_MARTIN         1 = add a Martin (vector tile) service — requires POSTGRES=1, 0 = off
# INSTANCE_<name>_MARTIN_PORT    bind for Martin, <ip>:<port> (only used when MARTIN=1)
# INSTANCE_<name>_POSTGRES_PORT  optional: publish Postgres itself, <ip>:<port> (e.g. for QGIS direct
#                                connections via the <app>_gis role — see `bdus app gis`). Requires
#                                POSTGRES=1. Leave empty (default) to keep Postgres internal-only.
#                                `bdus init` enables TLS on Postgres automatically when this is set
#                                (self-signed cert, generated once) — see README.md.

INSTANCE_prod_PORT=192.168.4.39:8081
INSTANCE_prod_POSTGRES=1
INSTANCE_prod_ALLOW_NEW_APP=0
INSTANCE_prod_CORS_ORIGIN=
INSTANCE_prod_MEM_API=1g
INSTANCE_prod_MEM_FRONT=192m
INSTANCE_prod_MARTIN=0
INSTANCE_prod_MARTIN_PORT=192.168.4.39:8091
INSTANCE_prod_POSTGRES_PORT=

INSTANCE_demo_PORT=192.168.4.39:8082
INSTANCE_demo_POSTGRES=0
INSTANCE_demo_ALLOW_NEW_APP=1
INSTANCE_demo_CORS_ORIGIN=
INSTANCE_demo_MEM_API=768m
INSTANCE_demo_MEM_FRONT=192m
INSTANCE_demo_MARTIN=0
INSTANCE_demo_MARTIN_PORT=192.168.4.39:8092
INSTANCE_demo_POSTGRES_PORT=
