# bdus-ops — nightly backup of every instance.
# Copy to /etc/cron.d/bdus-backup and adjust the path to `bdus` if needed.
#
#   sudo cp <repo>/etc/cron.d/bdus-backup /etc/cron.d/bdus-backup
#
# Runs as the user that owns the deploy (not root) so `docker` and the instance
# dirs are reachable. `bdus backup all` snapshots every instance into its restic
# repo under <instance>/backups/repo/ (a cold, off-box copy of <instance>/backups/
# is a separate concern — pull it over SSH after this run).
#
# That user can't create /var/log/bdus-backup.log, and cron's shell won't run
# the command if the redirect can't open. `bdus setup host` pre-creates it;
# otherwise:  sudo install -o debian -g debian -m 0644 /dev/null /var/log/bdus-backup.log

SHELL=/bin/bash
15 2 * * *  debian  /usr/local/bin/bdus backup all  >> /var/log/bdus-backup.log 2>&1
# weekly integrity check of every repo (5% data read)
# 40 3 * * 0  debian  /usr/local/bin/bdus backup verify all  >> /var/log/bdus-backup.log 2>&1
# optional heartbeat: mail yourself if anything is wrong
# 5  8 * * *  debian  /usr/local/bin/bdus status || echo "bdus status FAILED on $(hostname)"
